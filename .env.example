# 复制成 .env 后使用。本地开发各 host 都是 127.0.0.1。
# 云上部署时把 host 换成云服务器公网 IP，端口保持默认，安全组放开对应端口。

# ---- MySQL ----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root123456
MYSQL_DATABASE=wms

# ---- Neo4j ----
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j123456

# ---- Redis ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

# ---- Milvus ----
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_COLLECTION_BASE=wms_docs

# ---- 向量化 ----
# hash = 本地字符二元组哈希（512 维，离线可跑，默认）
# bge  = 租的 BAAI/bge-m3（1024 维，需要 EMBED_API_KEY）
EMBED_PROVIDER=hash
EMBED_API_KEY=
EMBED_BASE_URL=https://api.siliconflow.cn/v1
EMBED_MODEL=BAAI/bge-m3
EMBED_DIM_BGE=1024

# ---- 重排 ----
RERANK_ENABLED=off
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ---- LLM ----
# 面试演示必须能用 replay，断网也能跑
LLM_MODE=replay
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-flash
LLM_TIMEOUT=60
# 模型复核：默认 off。打开后每题多 7-10 秒，且意见仅供参考
LLM_REVIEW=off

# ---- App ----
APP_HOST=0.0.0.0
APP_PORT=8000
ONTOLOGY_PATH=ontology/wms.yaml
